ListenAddress <PROXMOX_TAILNET_IP>
Port 2223
HostKey /etc/ssh/ssh_host_ed25519_key
PidFile /run/crowdaware-ml-exports.pid
UsePAM yes
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers crowdaware-ml-export
AuthorizedKeysFile .ssh/authorized_keys
DisableForwarding yes
PermitTTY no
X11Forwarding no
MaxAuthTries 3
MaxSessions 2
LoginGraceTime 20
ClientAliveInterval 15
ClientAliveCountMax 3
ForceCommand /usr/bin/python3 /opt/crowdaware-ml-exports/remote-exports.py
