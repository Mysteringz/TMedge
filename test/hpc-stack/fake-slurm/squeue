#!/bin/bash
# Fake squeue: `-h -j ids -o "%i|%T"` for jobs not yet finished.
ids=
while [ $# -gt 0 ]; do case "$1" in -j) ids=$2; shift 2 ;; *) shift ;; esac; done
IFS=, read -ra list <<<"$ids"
for id in "${list[@]}"; do
  f="$HOME/.fakeslurm/$id"; [ -f "$f" ] || continue
  IFS='|' read -r st _ < "$f"
  case "$st" in PENDING|RUNNING) echo "$id|$st" ;; esac
done
