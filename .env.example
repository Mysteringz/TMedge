# Copy to .env (git-ignored). Generate secrets with: openssl rand -hex 32

# --- edge (npm run edge) ---
TM_KEY=                  # shared with TMnodes (`set key ...` on each node)
# TM_KEY_PREVIOUS=       # accepted too, while rotating to a new TM_KEY
# ALLOW_UNSIGNED=1       # bench only
# UDP_HOST=0.0.0.0       # bind the sensor uplink to one interface's address on a multi-homed NUC
# UDP_PORT=5200
# SITE_CONFIG=config/site.json
# NODES_CONFIG=config/nodes.json
# DATA_DIR=data
# RECORD_RAW=0           # 1 = keep every RAW frame (~70 MB/node/day) for calibration
ADMIN_PASSWORD=          # debug console; without it the console and algo console bind to localhost only
# ALGO_PORT=8091         # algo console (algo.hkumyseat.com); 0 = off. Sign-in is on whenever ADMIN_PASSWORD is.
# ALGO_USERS_FILE=data/algo/users.json   # accounts: npm run algo-user -- add <name>
# ALGO_SESSION_SECRET=   # 32+ chars; defaults to SESSION_SECRET (a derived key, never shared with the web tier's)
# CONSOLE_PORT=8090
WEB_PUSH_URLS=http://127.0.0.1:8080   # comma-separated web tiers, e.g. https://seats.example.hku.hk
WEB_PUSH_TOKEN=          # same value on the edge and the web tier

# --- firmware updates (console -> build -> rollout) ---
# PlatformIO on this machine; only needed if it is not in the usual places.
# PIO_PATH=/opt/platformio/penv/bin/pio

# --- access gateways (TMWAccess / TMLAccess) ---
TMGW_TOKEN=              # 16+ chars; the same value in each gateway's .env
# GATEWAY_PORT=5210

# --- web tier (npm run web) ---
SESSION_SECRET=          # 32+ chars
# WEB_PORT=8080
# ALLOWED_EMAIL_DOMAINS=hku.hk,connect.hku.hk
# SIGNUP_OPEN=1
# COOKIE_SECURE=1        # behind HTTPS (EC2 + ALB)
# TRUST_PROXY=1          # behind a load balancer / reverse proxy
# STALE_MS=30000         # an edge silent this long -> its floors show unknown
# Cloudflare Turnstile on sign-in and sign-up -- and on the algo console's
# sign-in, which runs in the edge and reads the same three: all three or none.
# Local testing: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=0x4AAAAAAFLu-aw-jNQIOCg6   # production widget; public, shown to browsers
# TURNSTILE_SECRET_KEY=  # secret, only sent to Cloudflare's siteverify
# TURNSTILE_HOSTNAMES=hkumyseat.com,algo.hkumyseat.com   # where a token may be solved; never localhost in production

# --- Docker (docker-compose.yml) ---
# Address the published ports listen on: 127.0.0.1 (this host only), or the
# host's LAN / Tailscale IP. Docker bypasses host firewall rules for these.
BIND_ADDR=127.0.0.1
# Cloudflare Tunnel token, for `docker compose --profile tunnel up -d`.
CLOUDFLARE_TUNNEL_TOKEN=
